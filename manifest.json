{
  "manifest_version": 3,
  "name": "TSR Skip Download Timer",
  "version": "1.0.0",
  "description": "Automatically downloads free files from The Sims Resource without manually waiting for the timer or login prompts. Guest flow, no account needed.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://www.thesimsresource.com/*",
    "https://downloads.thesimsresource.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.thesimsresource.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}